# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=silpo
# Use "db" when running via docker compose, "localhost" when running the API locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
# "local" (the default) or "production". "local" exposes API docs (/docs, /redoc, /openapi.json)
# and skips the login email-confirmation requirement (no verified sending domain locally to
# reliably deliver the confirmation email). Real deployments must set this to "production".
APP_ENV=local

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email (Resend - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Silpo <onboarding@resend.dev>
API_BASE_URL=http://localhost:8000
