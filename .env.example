# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=silpo
# Use "db" when running via docker compose, "localhost" when running the API locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
# "development" or "production". Production disables Swagger UI (/docs), ReDoc (/redoc) and the
# raw OpenAPI schema (/openapi.json).
APP_ENV=development

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# "local" skips the email-confirmation requirement on login (no verified sending domain
# yet to reliably deliver the confirmation email locally). Use "production" to require it.
APP_ENV=local

# Email (Resend - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Silpo <onboarding@resend.dev>
API_BASE_URL=http://localhost:8000
