# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=silpo
# Use "db" when running via docker compose, "localhost" when running the API locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
# "local" (the default) or "production". "local" exposes API docs (/docs, /redoc, /openapi.json)
# and skips the login email-confirmation requirement (no verified sending domain locally to
# reliably deliver the confirmation email). Real deployments must set this to "production".
APP_ENV=local

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email: "resend" (default) or "smtp".
EMAIL_PROVIDER=resend
# Resend (https://resend.com). Without a verified domain it only delivers to the account owner.
RESEND_API_KEY=
# SMTP, e.g. Gmail: needs 2-step verification and an app password
# (https://myaccount.google.com/apppasswords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# With SMTP, use the mailbox's own address (e.g. Silpo <you@gmail.com>).
EMAIL_FROM=Silpo <onboarding@resend.dev>
API_BASE_URL=http://localhost:8000
# Base URL of the web app; used to build the password-reset link (mobile reuses it as a
# universal/app link).
WEB_APP_URL=http://localhost:3000
