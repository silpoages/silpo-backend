# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=silpo
# Use "db" when running via docker compose, "localhost" when running the API locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# "local" sends email through the local SMTP catcher (Mailpit) below instead of Resend —
# no API key needed, and no Resend sandbox recipient restriction. Use "production" to send
# through Resend for real.
APP_ENV=local

# Email (Resend - https://resend.com). Only used when APP_ENV=production.
RESEND_API_KEY=
EMAIL_FROM=Silpo <onboarding@resend.dev>
API_BASE_URL=http://localhost:8000

# Local SMTP catcher (Mailpit, started via docker compose). Only used when APP_ENV=local.
# Web UI to view sent emails: http://localhost:8025
# Use "mailpit" when running via docker compose, "localhost" when running the API locally.
SMTP_HOST=localhost
SMTP_PORT=1025
